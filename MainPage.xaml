<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CampuGO.MainPage"
             BackgroundColor="#101719"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="*,Auto">
        <ScrollView x:Name="ContentScroll" Grid.Row="0">
            <VerticalStackLayout x:Name="PageContent" Padding="22,24,22,30" Spacing="22" />
        </ScrollView>
        <Grid x:Name="BottomNavigation" Grid.Row="1" BackgroundColor="#151E20"
              Padding="10,8,10,12" ColumnDefinitions="*,*,*,*,*" />
    </Grid>
</ContentPage>
